        </dependency>

        <dependency>
            <groupId>com.north</groupId>
            <artifactId>north-system</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
